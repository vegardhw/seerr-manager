SEERR_URL=https://your-overseerr-or-jellyseerr-url
SEERR_API_KEY=your-api-key
TMDB_API_KEY=your-tmdb-api-key

# Strongly recommended: set a strong random secret to protect all /api/* routes.
# All requests must include: Authorization: Bearer <APP_SECRET>
# Generate with: openssl rand -hex 32
APP_SECRET=

# Optional: comma-separated list of allowed CORS origins (only needed if you
# access the API from a different origin than where the UI is served).
# Leave empty to block all cross-origin requests (secure default).
# CORS_ORIGINS=http://localhost:5173
